{
  "manifest_version": 3,
  "name": "GPT Tweaks",
  "version": "0.8.1",
  "description": "为 ChatGPT 网页版提供快捷发送、列表续写与缩进、对话节点导航。",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "GPT Tweaks 设置",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "navigation-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js",
        "navigation.js"
      ],
      "css": [
        "navigation.css"
      ],
      "run_at": "document_start"
    }
  ]
}
