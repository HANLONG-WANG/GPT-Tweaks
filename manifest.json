{
  "manifest_version": 3,
  "name": "GPT Tweaks",
  "version": "0.1.0",
  "description": "在 ChatGPT 网页版中使用 Ctrl+Enter 发送消息，Enter 仅用于换行。",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}