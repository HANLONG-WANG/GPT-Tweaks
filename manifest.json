{
  "manifest_version": 3,
  "name": "GPT Tweaks",
  "version": "0.9.2",
  "description": "为 ChatGPT 网页版提供快捷发送、列表续写与缩进、对话节点导航和 Markdown 导出。",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GPT Tweaks 设置与导出",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "navigation-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js",
        "navigation.js",
        "conversation-download.js"
      ],
      "css": [
        "navigation.css",
        "conversation-download.css"
      ],
      "run_at": "document_start"
    }
  ]
}
